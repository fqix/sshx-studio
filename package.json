{
  "name": "sshx-studio",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "version": "0.1.0",
  "publisher": "fqix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fqix/sshx-studio.git"
  },
  "bugs": {
    "url": "https://github.com/fqix/sshx-studio/issues"
  },
  "homepage": "https://github.com/fqix/sshx-studio#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshxStudio",
          "title": "%viewContainer.title%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "sshxStudio": [
        {
          "id": "sshxStudio.hosts",
          "name": "%view.hosts%",
          "icon": "$(remote)"
        }
      ]
    },
    "commands": [
      {
        "command": "sshxStudio.connect",
        "title": "%cmd.connect%",
        "category": "SSHX",
        "icon": "$(terminal)"
      },
      {
        "command": "sshxStudio.addHost",
        "title": "%cmd.addHost%",
        "category": "SSHX",
        "icon": "$(add)"
      },
      {
        "command": "sshxStudio.editHost",
        "title": "%cmd.editHost%",
        "category": "SSHX",
        "icon": "$(edit)"
      },
      {
        "command": "sshxStudio.deleteHost",
        "title": "%cmd.deleteHost%",
        "category": "SSHX",
        "icon": "$(trash)"
      },
      {
        "command": "sshxStudio.copyPublicKey",
        "title": "%cmd.copyPublicKey%",
        "category": "SSHX",
        "icon": "$(key)"
      },
      {
        "command": "sshxStudio.importSshConfig",
        "title": "%cmd.importSshConfig%",
        "category": "SSHX",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sshxStudio.addForward",
        "title": "%cmd.addForward%",
        "category": "SSHX",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "sshxStudio.editForward",
        "title": "%cmd.editForward%",
        "category": "SSHX",
        "icon": "$(edit)"
      },
      {
        "command": "sshxStudio.deleteForward",
        "title": "%cmd.deleteForward%",
        "category": "SSHX",
        "icon": "$(trash)"
      },
      {
        "command": "sshxStudio.startForward",
        "title": "%cmd.startForward%",
        "category": "SSHX",
        "icon": "$(play)"
      },
      {
        "command": "sshxStudio.stopForward",
        "title": "%cmd.stopForward%",
        "category": "SSHX",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sshxStudio.toggleForwardAutoStart",
        "title": "%cmd.toggleForwardAutoStart%",
        "category": "SSHX"
      },
      {
        "command": "sshxStudio.copyForwardAddress",
        "title": "%cmd.copyForwardAddress%",
        "category": "SSHX",
        "icon": "$(copy)"
      },
      {
        "command": "sshxStudio.refresh",
        "title": "%cmd.refresh%",
        "category": "SSHX",
        "icon": "$(refresh)"
      },
      {
        "command": "sshxStudio.openConfig",
        "title": "%cmd.openConfig%",
        "category": "SSHX",
        "icon": "$(gear)"
      },
      {
        "command": "sshxStudio.revealDatabase",
        "title": "%cmd.revealDatabase%",
        "category": "SSHX",
        "icon": "$(database)"
      },
      {
        "command": "sshxStudio.diagnose",
        "title": "%cmd.diagnose%",
        "category": "SSHX"
      },
      {
        "command": "sshxStudio.uploadFromExplorer",
        "title": "%cmd.uploadFromExplorer%",
        "category": "SSHX",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sshxStudio.addHost",
          "when": "view == sshxStudio.hosts",
          "group": "navigation@1"
        },
        {
          "command": "sshxStudio.refresh",
          "when": "view == sshxStudio.hosts",
          "group": "navigation@2"
        },
        {
          "command": "sshxStudio.importSshConfig",
          "when": "view == sshxStudio.hosts",
          "group": "1_manage@1"
        },
        {
          "command": "sshxStudio.openConfig",
          "when": "view == sshxStudio.hosts",
          "group": "1_manage@2"
        },
        {
          "command": "sshxStudio.revealDatabase",
          "when": "view == sshxStudio.hosts",
          "group": "1_manage@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sshxStudio.connect",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "inline@1"
        },
        {
          "command": "sshxStudio.addForward",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "inline@2"
        },
        {
          "command": "sshxStudio.connect",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "1_open@1"
        },
        {
          "command": "sshxStudio.addForward",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "2_forward@1"
        },
        {
          "command": "sshxStudio.editHost",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "3_edit@1"
        },
        {
          "command": "sshxStudio.copyPublicKey",
          "when": "view == sshxStudio.hosts && viewItem == host.withPublicKey",
          "group": "3_edit@2"
        },
        {
          "command": "sshxStudio.deleteHost",
          "when": "view == sshxStudio.hosts && viewItem =~ /^host/",
          "group": "9_delete@1"
        },
        {
          "command": "sshxStudio.startForward",
          "when": "view == sshxStudio.hosts && viewItem == forward.stopped",
          "group": "inline@1"
        },
        {
          "command": "sshxStudio.stopForward",
          "when": "view == sshxStudio.hosts && viewItem == forward.running",
          "group": "inline@1"
        },
        {
          "command": "sshxStudio.startForward",
          "when": "view == sshxStudio.hosts && viewItem == forward.stopped",
          "group": "1_run@1"
        },
        {
          "command": "sshxStudio.stopForward",
          "when": "view == sshxStudio.hosts && viewItem == forward.running",
          "group": "1_run@1"
        },
        {
          "command": "sshxStudio.copyForwardAddress",
          "when": "view == sshxStudio.hosts && viewItem =~ /^forward/",
          "group": "1_run@2"
        },
        {
          "command": "sshxStudio.editForward",
          "when": "view == sshxStudio.hosts && viewItem =~ /^forward/",
          "group": "2_edit@1"
        },
        {
          "command": "sshxStudio.toggleForwardAutoStart",
          "when": "view == sshxStudio.hosts && viewItem =~ /^forward/",
          "group": "2_edit@2"
        },
        {
          "command": "sshxStudio.deleteForward",
          "when": "view == sshxStudio.hosts && viewItem =~ /^forward/",
          "group": "9_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sshxStudio.addForward",
          "when": "false"
        },
        {
          "command": "sshxStudio.editForward",
          "when": "false"
        },
        {
          "command": "sshxStudio.deleteForward",
          "when": "false"
        },
        {
          "command": "sshxStudio.startForward",
          "when": "false"
        },
        {
          "command": "sshxStudio.stopForward",
          "when": "false"
        },
        {
          "command": "sshxStudio.toggleForwardAutoStart",
          "when": "false"
        },
        {
          "command": "sshxStudio.copyForwardAddress",
          "when": "false"
        },
        {
          "command": "sshxStudio.refresh",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "sshxStudio.uploadFromExplorer",
          "when": "resourceScheme == file",
          "group": "7_sshx@1"
        }
      ]
    },
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "sshxStudio.databasePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.databasePath%"
        },
        "sshxStudio.configPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.configPath%"
        },
        "sshxStudio.terminalFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 6,
          "maximum": 40,
          "description": "%config.terminalFontSize%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "sshxStudio.hosts",
        "contents": "%view.hosts.welcome%"
      }
    ]
  },
  "scripts": {
    "postinstall": "npm --prefix webview-ui install",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "watch": "node esbuild.mjs --watch",
    "dev:webview": "npm --prefix webview-ui run dev",
    "typecheck": "tsc --noEmit && npm --prefix webview-ui run typecheck",
    "test": "node esbuild.mjs --test && node out/e2e.js",
    "package": "vsce package --no-dependencies",
    "l10n": "node scripts/l10n-check.mjs --write",
    "vscode:prepublish": "npm run build",
    "test:e2e": "npm run build && node test/vscode/runTest.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "extensionKind": [
    "ui"
  ],
  "l10n": "./l10n",
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ssh2": "1.17.0"
  }
}
